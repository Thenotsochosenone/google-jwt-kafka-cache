+      // These are synchronous network calls to Google's token endpoint.
+      // `blocking` tells the dispatcher's fork-join pool (if that's what
+      // ends up backing `ec`) to compensate by spinning up an extra
+      // thread while this one is parked — on top of (not instead of)
+      // running this class on its own dedicated dispatcher, which is
+      // the primary fix (see Main.scala / blocking-io-dispatcher in
+      // application.conf). Belt and suspenders: this line protects
+      // correctness even if someone constructs this class with the
+      // default dispatcher's EC by mistake.
+      val (tokenValue, expiresInMs) = blocking {
+        credentials.refreshIfExpired()
+
+        (audience, usingMock) match {
+          // Mock path for ID tokens – avoids ClassCastException on IdTokenProvider
+          case (Some(_), true) =>
+            val fakeJwt = MockGoogleCredentials.fakeJwt
+            (fakeJwt, 3600_000L)
+
+          // Real ID token path
+          case (Some(aud), false) =>
+            val idTokenCreds = IdTokenCredentials
+              .newBuilder()
+              .setIdTokenProvider(credentials.asInstanceOf[IdTokenProvider])
+              .setTargetAudience(aud)
+              .build()
+            val token = idTokenCreds.refreshAccessToken()
+            (
+              token.getTokenValue,
+              Option(token.getExpirationTime)
+                .map(_.getTime - System.currentTimeMillis())
+                .getOrElse(3600_000L)
+            )
+
+          // Access token (real or mock)
+          case (None, _) =>
+            val token = credentials.getAccessToken
+            (
+              token.getTokenValue,
+              Option(token.getExpirationTime)
+                .map(_.getTime - System.currentTimeMillis())
+                .getOrElse(3600_000L)
+            )
+        }
       }
 
       lastRefreshTimestamp.set(System.currentTimeMillis() / 1000.0)
