diff --git a/src/main/resources/application.conf b/src/main/resources/application.conf
index 06248e9..2126126 100644
--- a/src/main/resources/application.conf
+++ b/src/main/resources/application.conf
@@ -18,6 +18,21 @@ akka {
   }
 }
 
+# Dedicated pool for GoogleJwtTokenCache's blocking calls to Google's
+# token endpoint (credentials.refreshIfExpired() / refreshAccessToken()
+# are synchronous network I/O). Isolating them here means a slow or
+# hanging Google API call can't starve the dispatcher backing Akka HTTP
+# routes and the Kafka streams. Looked up via DispatcherSelector in
+# Main.scala and passed explicitly to GoogleJwtTokenCache.
+blocking-io-dispatcher {
+  type = Dispatcher
+  executor = "thread-pool-executor"
+  thread-pool-executor {
+    fixed-pool-size = 4
+  }
+  throughput = 1
+}
+
 app {
   kafka {
     bootstrap-servers = "localhost:9092"
